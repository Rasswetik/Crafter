# /etc/crafter/payout.env   (chmod 600, owner crafter). NEVER commit this file, never paste it in chats.
# Dedicated hot wallet V4R2 created only for payouts. Keep a small operating reserve in it.
CRAFTER_PAYOUT_MNEMONIC=
# Exact public address of that wallet in raw form 0:...
CRAFTER_PAYOUT_ADDRESS=
# Start with testnet. Switch to mainnet only after a successful test payout.
CRAFTER_PAYOUT_NETWORK=testnet
# 1 = the worker may sign. Leave 0 to keep payouts manual.
CRAFTER_PAYOUT_EXECUTE=1
# Required only for mainnet:
# CRAFTER_PAYOUT_MAINNET_UNLOCK=YES_I_ACCEPT_REAL_PAYOUTS
# Optional TON Center key (higher rate limits)
TONCENTER_API_KEY=
