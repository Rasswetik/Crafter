[Unit]
Description=Crafter (Flask + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=crafter
WorkingDirectory=/opt/crafter
EnvironmentFile=/opt/crafter/.env
Environment=PORT=5000
ExecStart=/opt/crafter/.venv/bin/gunicorn -c gunicorn.conf.py app:app
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/crafter

[Install]
WantedBy=multi-user.target
