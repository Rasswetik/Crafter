DEMO_MODE=1
BOT_TOKEN=
BOT_USERNAME=
# Numeric Telegram user ID of Crafter's primary IT administrator.
# Required when ADMIN_IDS contains more than one ID (do not use a username).
PRIMARY_ADMIN_ID=
ADMIN_IDS=5257227756
PORTALS_API_KEY=
DATABASE=instance/app.sqlite3


# ---- Portals Market ----
# Partner API key (PORTALS_API_KEY above) is optional: leave empty to use only the
# public catalogue. Prefer saving it from the admin panel (stored encrypted).
# Fernet key that encrypts the partner key in the database:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CRAFTER_PORTALS_FERNET_KEY=
# Real purchases need ALL of: this =1, PostgreSQL (DATABASE_URL), a verified key,
# and the operator enabling live checkout in the admin panel. Default off.
CRAFTER_PORTALS_LIVE_PURCHASES=0
# Shared PostgreSQL (required for Partner API / live purchases), e.g.
# postgresql://user:pass@127.0.0.1:5432/crafter
DATABASE_URL=

# ---- Market refresh ----
# Refresh the Portals catalogue every N seconds (0 = off, minimum 60).
MARKET_REFRESH_SECONDS=900
# Also refresh once at start-up.
CATALOG_REFRESH_ON_START=1

# ---- Server ----
PORT=5000
